# Supabase — em https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NUNCA exponha esta chave ao client — só é lida em código server-side (rota de cron).
SUPABASE_SERVICE_ROLE_KEY=

# Resend — em https://resend.com/api-keys
RESEND_API_KEY=
# Em desenvolvimento pode usar o domínio de teste do Resend:
EMAIL_REMETENTE=onboarding@resend.dev
# Destino dos lembretes diários (e-mail interno da equipe):
EMAIL_NOTIFICACOES_DESTINO=

# Cron — gere uma string aleatória (ex: `openssl rand -hex 32`) e configure
# o mesmo valor nas Environment Variables do projeto na Vercel.
CRON_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
